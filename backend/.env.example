# Database
DATABASE_URL="postgresql://user:password@localhost:5432/fundakamental"

# JWT Authentication
SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local testing only. Keep disabled in production.
ENABLE_TEST_LOGIN=False
TEST_LOGIN_TOKEN="dev-test-token"

# OpenAI
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4-turbo-preview"

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY="your_anthropic_api_key"
ANTHROPIC_MODEL="claude-3-sonnet-20240229"

# Vector Database
CHROMA_PERSIST_DIRECTORY="./data/chroma"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Celery
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE=26214400  # 25MB in bytes

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:8080,http://localhost:8081"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Stock Data APIs (choose one or more)
ALPHA_VANTAGE_API_KEY="your_alpha_vantage_api_key"
FMP_API_KEY="your_financial_modeling_prep_api_key"
POLYGON_API_KEY="your_polygon_io_api_key"

# Stripe (for payments - optional)
STRIPE_SECRET_KEY="your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret"
STRIPE_PRICE_ID_MONTHLY="price_xxxxx"
STRIPE_PRICE_ID_ANNUAL="price_xxxxx"

# URLs (for CORS and redirects)
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8080"
